    # "りずむ「玉木さん。{w=0.4}ありがとうございます」"
    "音律「玉木小姐。{w=0.4}谢谢您」"

# game/scenario/m_b6.rpy:1386
translate zh_cn kag_m_b6_mo__dash__06_10_8290528f:

