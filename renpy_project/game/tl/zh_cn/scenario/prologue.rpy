
# game/scenario/prologue.rpy:28
translate zh_cn kag_prologue_prologue_5959d2c0:

    # "魔女Ａ　「ほらそこ、しっかりしなさい！」{nw}"
    "魔女A「喂，那边那个，给我专心点！」{nw}"

# game/scenario/prologue.rpy:33
translate zh_cn kag_prologue_prologue_a4549aef:

    # "魔女の子「すみませんっ、しっかりやります……{w=0.55}ああっ！」{nw}"
    "小魔女「对不起！我会专心做的……{w=0.55}哎呀！」{nw}"

# game/scenario/prologue.rpy:38
translate zh_cn kag_prologue_prologue_63b01fe8:

    # "魔女Ｂ　「はやくしてくれないと、こっちの仕事が遅れちゃうじゃない！」{nw}"
    "魔女B「你再不动作快点，我这边的工作都要跟着被拖累了啦！」{nw}"

# game/scenario/prologue.rpy:43
translate zh_cn kag_prologue_prologue_42893acc:

    # "魔女の子「すみませんっ、はやくやります……{w=0.55}あらら？」{nw}"
    "小魔女「对不起！我马上弄好……{w=0.55}咦？」{nw}"

# game/scenario/prologue.rpy:48
translate zh_cn kag_prologue_prologue_e2969bb4:

    # "魔女Ｃ　「ちょっと～。\n頼んでおいたお使い、まだ行ってくれてないの？」{nw}"
    "魔女C「我说啊～\n拜托你去跑腿的事，你还没去办吗？」{nw}"

# game/scenario/prologue.rpy:53
translate zh_cn kag_prologue_prologue_15a9102f:

    # "魔女の子「すみませんっ、これが終わったらすぐに……\n{w=0.45}きゃあっ！」{nw}"
    "小魔女「对不起！等手头这点做完我立刻就……\n{w=0.45}呀啊！」{nw}"

# game/scenario/prologue.rpy:59
translate zh_cn kag_prologue_prologue_6f4dfac4:

    # "魔女Ａ　「ハァ。もういいわ。お使いはわたしが行ってくるから、\nあなたは今やってる仕事を片づけなさい」{nw}"
    "魔女A「唉，算了。跑腿还是我自己去吧，\n你把现在正在做的活收拾完就行。」{nw}"

# game/scenario/prologue.rpy:64
translate zh_cn kag_prologue_prologue_2d335b7d:

    # "魔女の子「すみませんっ……{w=0.55}ホントにすみません……」{nw}"
    "小魔女「对不起……{w=0.55}真的非常对不起……」{nw}"

# game/scenario/prologue.rpy:73
translate zh_cn kag_prologue_prologue_88159f6f:

    # "魔女Ｂ　「まったくドジね、あの子は……」{nw}"
    "魔女B「那孩子真是笨手笨脚的……」{nw}"

# game/scenario/prologue.rpy:77
translate zh_cn kag_prologue_prologue_2b6b169c:

    # "魔女Ｃ　「ほんと、お仕事失敗ばかりしているわね。\nお使いに行っても道に迷うばっかりだし」{nw}"
    "魔女C「就是说呀，干活总是出纰漏。\n就连叫她出去跑个腿也会迷路。」{nw}"

# game/scenario/prologue.rpy:81
translate zh_cn kag_prologue_prologue_9863f567:

    # "魔女Ｂ　「なんであんな子が仕事してるのかしら。\nさっさとクビにしちゃえばいいのに……」{nw}"
    "魔女B「真搞不懂那种孩子怎么还在这里做事。\n早点把她辞掉算了……」{nw}"

# game/scenario/prologue.rpy:85
translate zh_cn kag_prologue_prologue_edd43a4c:

    # "魔女Ｃ　「なんかうわさでは友だちもいないって言うわよ……」{nw}"
    "魔女C「而且听说她连一个朋友都没有呢……」{nw}"

# game/scenario/prologue.rpy:89
translate zh_cn kag_prologue_prologue_ed19880b:

    # "魔女Ｂ　「まぁ、そうですの。でもそんな感じしますわね。\nいっつもグズグズしてますしね」{nw}"
    "魔女B「哎呀，真的吗？不过看她那样子也确实像。\n整天都是磨磨蹭蹭的。」{nw}"

# game/scenario/prologue.rpy:93
translate zh_cn kag_prologue_prologue_b882f0e9:

    # "魔女Ｃ　「あんなに失敗ばかりしていたら、わたしたちまでいっしょに怒られちゃうわよ。まったく……」{nw}"
    "魔女C「她要是再这么老是出错，连我们都要一起挨骂的。真是的……」{nw}"

# game/scenario/prologue.rpy:96
translate zh_cn kag_prologue_prologue_a1229908:

    # "少し離れた場所から、魔女たちのうわさ話が聞こえてくる。{nw}"
    "从稍远的地方，传来了魔女们说闲话的声音。{nw}"

# game/scenario/prologue.rpy:101
translate zh_cn kag_prologue_prologue_85551b6e:

    # "魔女の子「またわたしのこと、うわさしてる」{nw}"
    "小魔女「她们又在背后议论我了……」{nw}"

# game/scenario/prologue.rpy:108
translate zh_cn kag_prologue_prologue_1d0cdf42:

    # "魔女の子「どうしていつも悪口言われちゃうのかな？」{nw}"
    "小魔女「为什么大家总是这样说我的坏话呢？」{nw}"

# game/scenario/prologue.rpy:115
translate zh_cn kag_prologue_prologue_ce196588:

    # "魔女の子「やっぱり、わたしがドジなせいかな……」{nw}"
    "小魔女「果然……还是因为我太笨手笨脚了吧……」{nw}"

# game/scenario/prologue.rpy:120
translate zh_cn kag_prologue_prologue_7bc817b2:

    # "わたしは、涙をこらえるのがせいいっぱいだった。{nw}"
    "我拼命忍住眼泪，不让它流下来。{nw}"

# game/scenario/prologue.rpy:124
translate zh_cn kag_prologue_prologue_e4e94879:

    # "マジョリン「あなた方、そこでなにを話しているのですか。{w=0.45}ここは城内です。{w=0.45}静かにしなさい」{nw}"
    "魔女琳「你们几位，在那里聊什么呢。{w=0.45}这里是王城内部。{w=0.45}都安静点。」{nw}"

# game/scenario/prologue.rpy:128
translate zh_cn kag_prologue_prologue_65bd7092:

    # "魔女Ｂ＆Ｃ「すみませ～ん！」{nw}"
    "魔女B&C「非常抱歉～！」{nw}"

# game/scenario/prologue.rpy:132
translate zh_cn kag_prologue_prologue_a42ad8c2:

    # "マジョリン「そこで聞いているあなたも、はやく仕事にもどりなさい」{nw}"
    "魔女琳「站在那儿偷听的你，也赶快回去干活。」{nw}"

# game/scenario/prologue.rpy:137
translate zh_cn kag_prologue_prologue_4a6cd509:

    # "魔女の子　「すみません！{w=0.3}あっ！」{nw}"
    "小魔女「是，对不起！{w=0.3}啊！」{nw}"

# game/scenario/prologue.rpy:142
translate zh_cn kag_prologue_prologue_542027e1:

    # "つまずいてしまった。{nw}"
    "不小心绊倒了。{nw}"

# game/scenario/prologue.rpy:145
translate zh_cn kag_prologue_prologue_d04b81e3:

    # "そこいらにちらばる荷物。{nw}"
    "东西撒得满地都是。{nw}"

# game/scenario/prologue.rpy:148
translate zh_cn kag_prologue_prologue_cb8ea455:

    # "マジョリンさんのあきれ顔。{nw}"
    "魔女琳小姐一脸无语地望着我。{nw}"

# game/scenario/prologue.rpy:153
translate zh_cn kag_prologue_prologue_ebeec2ba:

    # "魔女の子　「すみません！すみませんっ！」{nw}"
    "小魔女「对不起！真的对不起！」{nw}"

# game/scenario/prologue.rpy:158
translate zh_cn kag_prologue_prologue_20c128d2:

    # "マジョリン「……」{nw}"
    "魔女琳「……」{nw}"

# game/scenario/prologue.rpy:163
translate zh_cn kag_prologue_prologue_60e1f53e:

    # "魔女の子　「ハァ、わたし、ダメだなぁ……」{nw}"
    "小魔女「唉，我真没用啊……」{nw}"

# game/scenario/prologue.rpy:176
translate zh_cn kag_prologue_prologue_2b8420da:

    # "魔女の子「わたしって、どうしていつも失敗ばかりしちゃうんだろう」{w=1.2}{nw}"
    "小魔女「我为什么总是做什么都搞砸呢……」{w=1.2}{nw}"

# game/scenario/prologue.rpy:180
translate zh_cn kag_prologue_prologue_3856e8a5:

    # "また涙がこぼれそうになるのをどうにかこらえ、空を見あげる。{nw}"
    "我好不容易才忍住快要夺眶而出的眼泪，抬头望向天空。{nw}"

# game/scenario/prologue.rpy:185
translate zh_cn kag_prologue_prologue_b92a6e1d:

    # "魔女の子「あれ……？」{w=1.5}{nw}"
    "小魔女「咦……？」{w=1.5}{nw}"

# game/scenario/prologue.rpy:189
translate zh_cn kag_prologue_prologue_6125713a:

    # "お城の外の、いつもの風景。{nw}"
    "城堡外面，还是和往常一样的风景。{nw}"

# game/scenario/prologue.rpy:192
translate zh_cn kag_prologue_prologue_ab2cc311:

    # "１つちがう所は、お城の３階くらいの高さを、ほうきに乗ってポロンを振り回して飛んでいる子たちの姿だ。{nw}"
    "唯一不同的是，大约在城堡三楼高的空中，有几个骑着扫帚、挥舞着波龙飞过的小女孩。{nw}"

# game/scenario/prologue.rpy:195
translate zh_cn kag_prologue_prologue_94e318aa:

    # "年は、ちょうどわたしと同じくらい。{nw}"
    "年纪看起来，正好跟我差不多大。{nw}"

# game/scenario/prologue.rpy:200
translate zh_cn kag_prologue_prologue_71251a66:

    # "魔女の子「あれ、なんだろう。あのにぎやかな人たち」{w=1.2}{nw}"
    "小魔女「那些人是谁呀，好热闹的样子……」{w=1.2}{nw}"

# game/scenario/prologue.rpy:206
translate zh_cn kag_prologue_prologue_fe3ea321:

    # "魔女の子「見習い服？魔女見習いさんかな……」{w=1.2}{nw}"
    "小魔女「见习服？难道是魔女见习生吗……」{w=1.2}{nw}"

# game/scenario/prologue.rpy:214
translate zh_cn kag_prologue_prologue_76b97e07:

    # "魔女見習い「どれみちゃん、ふざけて飛んでたらあかんて！」{w=0.6}{nw}"
    "见习魔女「DoReMi，骑扫帚飞的时候别胡闹啦，很危险的！」{w=0.6}{nw}"

# game/scenario/prologue.rpy:220
translate zh_cn kag_prologue_prologue_6966ba4f:

    # "魔女見習い「そうよ、あぶないわ」{w=0.6}{nw}"
    "见习魔女「就是啊，太危险了！」{w=0.6}{nw}"

# game/scenario/prologue.rpy:226
translate zh_cn kag_prologue_prologue_f776dd22:

    # "魔女見習い「だいじょうぶだってぇぇぇぇぇ！おおぅぅぅ！」{w=0.6}{nw}"
    "见习魔女「没关系的啦啊啊啊啊啊！哇啊啊啊！」{w=0.6}{nw}"

# game/scenario/prologue.rpy:233
translate zh_cn kag_prologue_prologue_c29dc8e7:

    # "魔女見習い「アハハハハハハ」{w=0.6}{nw}"
    "见习魔女「啊哈哈哈哈哈哈！」{w=0.6}{nw}"

# game/scenario/prologue.rpy:243
translate zh_cn kag_prologue_prologue_2f9af952:

    # "魔女見習い「さぁ、ふざけてないで、はやくＭＡＨＯ堂に戻りましょう」{w=1}{nw}"
    "见习魔女「好了，别光顾着玩了，快点回魔法堂吧。」{w=1}{nw}"

# game/scenario/prologue.rpy:249
translate zh_cn kag_prologue_prologue_70cce477:

    # "魔女見習い「寄り道してるとまたマジョリカがうるさいで～」{w=1}{nw}"
    "见习魔女「再绕路的话，魔女莉卡又要唠叨个没完咯～」{w=1}{nw}"

# game/scenario/prologue.rpy:258
translate zh_cn kag_prologue_prologue_d58aaaf9:

    # "魔女の子　「……あの魔女見習いさんたち、お仕事の途中なのかなぁ」{w=1}{nw}"
    "小魔女「……那些魔女见习生们，是在去工作的路上吗？」{w=1}{nw}"

# game/scenario/prologue.rpy:264
translate zh_cn kag_prologue_prologue_b3570892:

    # "魔女の子　「なんだかとっても楽しそうだったなぁ」{w=1}{nw}"
    "小魔女「总觉得她们看起来好开心啊……」{w=1}{nw}"

# game/scenario/prologue.rpy:270
translate zh_cn kag_prologue_prologue_8fddcc26:

    # "魔女の子　「いいなぁ。{w=0.4}わたしもああいうふうに、お友だちといっしょにお仕事ができたらなぁ……」{w=1}{nw}"
    "小魔女「真好啊。{w=0.4}要是我也能像那样，和朋友们一起工作就好了……」{w=1}{nw}"

# game/scenario/prologue.rpy:276
translate zh_cn kag_prologue_prologue_6ca3694f:

    # "魔女の子　「ちょっとくらい失敗しても、がみがみ怒られないだろうし。{w=0.55}陰で悪口なんか言われないだろうし、楽しいだろうなぁ」{w=1}{nw}"
    "小魔女「就算偶尔出点小错，也不会被人劈头盖脸地骂吧。{w=0.55}更不会有人在背后说坏话，一定很快乐吧……」{w=1}{nw}"

# game/scenario/prologue.rpy:280
translate zh_cn kag_prologue_prologue_31c8903c:

    # "魔女見習いたちが去った空の向こうを、\nわたしはしばらくの間ながめ続けていた。{nw}"
    "朝着魔女见习生们飞远的天空另一端，\n我呆呆地凝望了好一阵子。{nw}"

# game/scenario/prologue.rpy:285
translate zh_cn kag_prologue_prologue_9e021f5d:

    # "魔女の子　「お友だち……{w=1}か……」{nw}"
    "小魔女「朋友……{w=1}吗……」{nw}"

